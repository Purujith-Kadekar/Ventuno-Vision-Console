# Ventuno Eye - environment variables
#
# Local dev:  copy this file to .env.local and fill in the values.
# Vercel:     add the same variables under Project -> Settings -> Environment Variables,
#             then redeploy (changes do not affect existing deployments).
#
# NEVER commit a file with real values. Only this example file belongs in git.

# ---- login (REQUIRED) ----
# The username and PIN the web UI asks for. It is the only gate in front of
# the camera, so use a long passphrase (12+ characters), not a 4-digit PIN.
WEB_USERNAME=your-login-name
WEB_PIN=your-long-passphrase

# ---- session signing (REQUIRED) ----
# Signs the login cookie. Any long random string:  openssl rand -hex 32
# In production the app refuses to log anyone in without it.
SESSION_SECRET=generate-with-openssl-rand-hex-32

# ---- board API key (REQUIRED) ----
# The Ventuno Q sends this as the X-Api-Key header when it polls the app.
# Generate a separate value:  openssl rand -hex 32   (must differ from SESSION_SECRET)
# Put the same value in the board's data/vision_webapp.json.
# If unset, nobody is treated as the board (fail closed).
SYNC_API_KEY=generate-another-with-openssl-rand-hex-32

# ---- Firestore (RECOMMENDED on Vercel) ----
# Serverless instances do not share memory, so the board and browser need a
# shared store. Create a Firebase project with Firestore (Native mode), generate
# a service-account key, and paste the WHOLE JSON on ONE line:
#     jq -c . your-project-firebase-adminsdk-xxxxx.json
# Leave this unset for local dev (an in-memory + /tmp store is used instead).
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ---- optional: default board URL (local dev only) ----
# Used by the camera page's "direct" mode. Skip this on Vercel: it is baked into
# the public JavaScript, and an HTTPS page cannot call an http:// LAN address.
# NEXT_PUBLIC_BOARD_URL=http://192.168.1.50:8090
